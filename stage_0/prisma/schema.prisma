// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//USER MODEL
model User {
  id        String    @id @default(uuid())
  name      String    @unique
  email     String    @unique
  password  String
  boards    Board[]
  comments  Comment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Board - Belongs to user
model Board {
  id          String   @id @default(uuid())
  title       String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  columns     Column[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Column - Belongs to a Board
model Column {
  id            String   @id @default(uuid())
  name          String
  positionIndex Int
  boardId       String
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards         Card[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([boardId])
}

// Card - Belongs to a Column
model Card {
  id            String    @id @default(uuid())
  title         String
  content       String?
  positionIndex Int
  dueDate       DateTime?
  version       Int       @default(1)
  rank          String
  columnId      String
  comments      Comment[]
  column        Column    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  tags          Tag[]     @relation("CardToTag")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([columnId, rank])
  @@index([columnId, rank])
}

// Tag - Can be attached to many Cards
model Tag {
  id        String   @id @default(uuid())
  label     String   @unique
  colorHex  String   @default("#FFFFFF")
  cards     Card[]   @relation("CardToTag")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Comment - Belongs to a user and card
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  cardId    String
  parentId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  card    Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("ThreadedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("ThreadedReplies")

  @@index([cardId])
  @@index([parentId])
}
